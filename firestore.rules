             hasRequiredFields(['id', 'type', 'title', 'date', 'description', 'priority', 'status']) &&
             data.id is string && data.id.size() >= 1 && data.id.size() <= 50 &&
             data.type in ['Harian', 'Mingguan', 'Bulanan'] &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.date is string && data.date.size() >= 8 && data.date.size() <= 15 &&
             isValidOptionalString('time_start', 0, 10) &&
             isValidOptionalString('time_end', 0, 10) &&
             isValidOptionalString('location', 0, 100) &&
             data.description is string && data.description.size() <= 1000 &&
             data.priority in ['Penting & Mendesak', 'Prioritas Tinggi', 'Rutin'] &&
             data.status in ['Terjadwal', 'Sedang Berjalan', 'Selesai'];
    }

    // ===============================================================
    // Root Rule: Default Deny All
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // 1. PROFILES COLLECTION
    // ===============================================================
    match /profiles/{userId} {
      // Authenticated school staff can read staff directory
      allow read: if isAuthenticated();

      // Creation allowed by Admin, or user registering with default non-privileged role
      allow create: if isAuthenticated() &&
                    isValidProfile(request.resource.data) &&
                    request.resource.data.id == userId &&
                    (
                      isAdmin() ||
                      (isOwner(userId) && request.resource.data.roles == ['Guru Mapel'])
                    );

      // Updates allowed by Admin (can change roles), or self-update for profile info only (roles & active state immutable)
      allow update: if isAuthenticated() &&
                    isValidProfile(request.resource.data) &&
                    (
                      isAdmin() ||
                      (
                        isOwner(userId) &&
                        areImmutableFieldsUnchanged(['id', 'roles', 'is_active'])
                      )
                    );

      // Deletion allowed only by Admin (cannot delete own profile)
      allow delete: if isAdmin() && !isOwner(userId);
    }

    // ===============================================================
    // 2. CLASSES COLLECTION
    // ===============================================================
    match /classes/{classId} {
      allow read: if isAuthenticated();

      allow create: if (isAdmin() || isPrincipal()) &&
                    isValidClass(request.resource.data) &&
                    request.resource.data.id == classId;

      allow update: if isAuthenticated() &&
                    isValidClass(request.resource.data) &&
                    areImmutableFieldsUnchanged(['id']) &&
                    (
                      isAdmin() ||
                      isPrincipal() ||
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['student_count'])
                    );

      allow delete: if isAdmin();
    }

    // ===============================================================
    // 3. STUDENTS COLLECTION (DAPODIK INTERNAL)
    // ===============================================================
    match /students/{studentId} {
      allow read: if isAuthenticated();

      allow create: if (isAdmin() || isPrincipal()) &&
                    isValidStudent(request.resource.data) &&
                    request.resource.data.id == studentId;

      allow update: if (isAdmin() || isPrincipal()) &&
                    isValidStudent(request.resource.data) &&
                    areImmutableFieldsUnchanged(['id']);

      allow delete: if isAdmin();
    }

    // ===============================================================
    // 4. SCHEDULES COLLECTION
    // ===============================================================
    match /schedules/{scheduleId} {
      allow read: if isAuthenticated();

      allow create: if (isAdmin() || isPrincipal()) &&
                    isValidSchedule(request.resource.data) &&
                    request.resource.data.id == scheduleId;

      allow update: if (isAdmin() || isPrincipal()) &&
                    isValidSchedule(request.resource.data) &&
                    areImmutableFieldsUnchanged(['id']);

      allow delete: if isAdmin();
    }

    // ===============================================================
    // 5. STAFF ATTENDANCE COLLECTION
    // ===============================================================
    match /staff_attendance/{attendanceId} {
      allow read: if isAuthenticated();

      // Check-in by the staff member themselves or school leadership
      allow create: if isAuthenticated() &&
                    isValidStaffAttendance(request.resource.data) &&
                    (
                      request.resource.data.user_id == request.auth.uid ||
                      isAdmin() ||
                      isPrincipal()
                    );

      // Checkout or update by staff owner or leadership
      allow update: if isAuthenticated() &&
                    isValidStaffAttendance(request.resource.data) &&
                    areImmutableFieldsUnchanged(['id', 'user_id', 'date']) &&
                    (
                      resource.data.user_id == request.auth.uid ||
                      isAdmin() ||
                      isPrincipal()
                    );

      allow delete: if isAdmin();
    }

    // ===============================================================
    // 6. TEACHING JOURNALS COLLECTION
    // ===============================================================
    match /teaching_journals/{journalId} {
      allow read: if isAuthenticated();

      // Created by the teaching staff, Piket Lapangan (substitutions), or Admin/Kepsek
      allow create: if isAuthenticated() &&
                    isValidTeachingJournal(request.resource.data) &&
                    (
                      request.resource.data.teacher_id == request.auth.uid ||
                      isPiketLapangan() ||
                      isAdmin() ||
                      isPrincipal()
                    );

      allow update: if isAuthenticated() &&
                    isValidTeachingJournal(request.resource.data) &&
                    areImmutableFieldsUnchanged(['id', 'created_at']) &&
                    (
                      resource.data.teacher_id == request.auth.uid ||
                      isAdmin() ||
                      isPrincipal()
                    );

      allow delete: if isAdmin() || (isAuthenticated() && resource.data.teacher_id == request.auth.uid);
    }

    // ===============================================================
    // 7. SHADOW JOURNALS COLLECTION
    // ===============================================================
    match /shadow_journals/{shadowJournalId} {
      allow read: if isAuthenticated();

      // Created by the assigned shadow teacher or Admin/Kepsek
      allow create: if isAuthenticated() &&
                    isValidShadowJournal(request.resource.data) &&
                    (
                      request.resource.data.shadow_teacher_id == request.auth.uid ||
                      isAdmin() ||
                      isPrincipal()
                    );

      allow update: if isAuthenticated() &&
                    isValidShadowJournal(request.resource.data) &&
                    areImmutableFieldsUnchanged(['id', 'created_at']) &&
                    (
                      resource.data.shadow_teacher_id == request.auth.uid ||
                      isAdmin() ||
                      isPrincipal()
                    );

      allow delete: if isAdmin() || (isAuthenticated() && resource.data.shadow_teacher_id == request.auth.uid);
    }

    // ===============================================================
    // 8. TAHFIDZ PROGRESS COLLECTION
    // ===============================================================
    match /tahfidz_progress/{tahfidzId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() &&
                    isValidTahfidz(request.resource.data) &&
                    (
                      request.resource.data.teacher_id == request.auth.uid ||
                      isTeacher() ||
                      isAdmin() ||
                      isPrincipal()
                    );

      allow update: if isAuthenticated() &&
                    isValidTahfidz(request.resource.data) &&
                    areImmutableFieldsUnchanged(['id', 'created_at']) &&
                    (
                      resource.data.teacher_id == request.auth.uid ||
                      isTeacher() ||
                      isAdmin() ||
                      isPrincipal()
                    );

      allow delete: if isAdmin() || (isAuthenticated() && resource.data.teacher_id == request.auth.uid);
    }

    // ===============================================================
    // 9. KURIKULUM MERDEKA TP COLLECTION
    // ===============================================================
    match /kurikulum_tp/{tpId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() &&
                    isValidKurikulumTP(request.resource.data) &&
                    (isTeacher() || isAdmin() || isPrincipal());

      allow update: if isAuthenticated() &&
                    isValidKurikulumTP(request.resource.data) &&
                    areImmutableFieldsUnchanged(['id']) &&
                    (isTeacher() || isAdmin() || isPrincipal());

      allow delete: if isAdmin() || isPrincipal();
    }

    // ===============================================================
    // 10. STUDENT GRADES COLLECTION
    // ===============================================================
    match /student_grades/{gradeId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() &&
                    isValidStudentGrade(request.resource.data) &&
                    (isTeacher() || isAdmin() || isPrincipal());

      allow update: if isAuthenticated() &&
                    isValidStudentGrade(request.resource.data) &&
                    areImmutableFieldsUnchanged(['id', 'student_id', 'tp_id']) &&
                    (isTeacher() || isAdmin() || isPrincipal());

      allow delete: if isAdmin() || isPrincipal();
    }

    // ===============================================================
    // 11. FEE SPP RECORDS COLLECTION
    // ===============================================================
    match /fee_spp/{sppId} {
      allow read: if isAuthenticated();

      allow create: if (isAdmin() || isPrincipal()) &&
                    isValidFeeSpp(request.resource.data) &&
                    request.resource.data.id == sppId;

      allow update: if (isAdmin() || isPrincipal()) &&
                    isValidFeeSpp(request.resource.data) &&
                    areImmutableFieldsUnchanged(['id', 'student_id', 'academic_year_id', 'month']);

      allow delete: if isAdmin();
    }

    // ===============================================================
    // 12. FEE ANNUAL SUMMARY COLLECTION
    // ===============================================================
    match /fee_annual_summary/{summaryId} {
      allow read: if isAuthenticated();

      allow create: if (isAdmin() || isPrincipal()) &&
                    isValidFeeAnnualSummary(request.resource.data) &&
                    request.resource.data.id == summaryId;

      allow update: if (isAdmin() || isPrincipal()) &&
                    isValidFeeAnnualSummary(request.resource.data) &&
                    areImmutableFieldsUnchanged(['id', 'student_id']);

      allow delete: if isAdmin();
    }

    // ===============================================================
    // 13. FEE ANNUAL INSTALLMENTS COLLECTION
    // ===============================================================
    match /fee_annual_installments/{installmentId} {
      allow read: if isAuthenticated();

      allow create: if (isAdmin() || isPrincipal()) &&
                    isValidFeeAnnualInstallment(request.resource.data) &&
                    request.resource.data.id == installmentId;

      allow update: if (isAdmin() || isPrincipal()) &&
                    isValidFeeAnnualInstallment(request.resource.data) &&
                    areImmutableFieldsUnchanged(['id', 'student_id', 'installment_number']);

      allow delete: if isAdmin();
    }

    // ===============================================================
    // 14. FINANCE TRANSACTIONS COLLECTION (3 POS KAS)
    // ===============================================================
    match /finance_transactions/{transactionId} {
      // Sensitive financial ledger: restricted to Admin, Kepsek, Developer
      allow read: if isAuthenticated() && (isAdmin() || isPrincipal());

      allow create: if (isAdmin() || isPrincipal()) &&
                    isValidFinanceTransaction(request.resource.data) &&
                    request.resource.data.id == transactionId;

      allow update: if (isAdmin() || isPrincipal()) &&
                    isValidFinanceTransaction(request.resource.data) &&
                    areImmutableFieldsUnchanged(['id']);

      allow delete: if isAdmin();
    }

    // ===============================================================
    // 15. LETTER TEMPLATES COLLECTION
    // ===============================================================
    match /letter_templates/{templateId} {
      allow read: if isAuthenticated();

      allow create: if (isAdmin() || isPrincipal()) &&
                    isValidLetterTemplate(request.resource.data);

      allow update: if (isAdmin() || isPrincipal()) &&
                    isValidLetterTemplate(request.resource.data) &&
                    areImmutableFieldsUnchanged(['id']);

      allow delete: if isAdmin();
    }

    // ===============================================================
    // 16. LETTER ARCHIVES COLLECTION
    // ===============================================================
    match /letter_archives/{archiveId} {
      allow read: if isAuthenticated();

      allow create: if (isAdmin() || isPrincipal()) &&
                    isValidLetterArchive(request.resource.data);

      allow update: if (isAdmin() || isPrincipal()) &&
                    isValidLetterArchive(request.resource.data) &&
                    areImmutableFieldsUnchanged(['id', 'created_by']);

      allow delete: if isAdmin();
    }

    // ===============================================================
    // 17. SARPRAS ITEMS COLLECTION
    // ===============================================================
    match /sarpras_items/{itemId} {
      allow read: if isAuthenticated();

      allow create: if (isSarpras() || isAdmin() || isPrincipal()) &&
                    isValidSarprasItem(request.resource.data);

      // Sarpras/Admin/Kepsek can update anything; teachers reporting damage can update condition
      allow update: if isAuthenticated() &&
                    isValidSarprasItem(request.resource.data) &&
                    areImmutableFieldsUnchanged(['id']) &&
                    (
                      isSarpras() ||
                      isAdmin() ||
                      isPrincipal() ||
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['condition'])
                    );

      allow delete: if isSarpras() || isAdmin();
    }

    // ===============================================================
    // 18. SARPRAS TICKETS COLLECTION
    // ===============================================================
    match /sarpras_tickets/{ticketId} {
      allow read: if isAuthenticated();

      // Any staff can submit a ticket; must set themselves as reporter
      allow create: if isAuthenticated() &&
                    isValidSarprasTicket(request.resource.data) &&
                    (
                      request.resource.data.reported_by_id == request.auth.uid ||
                      isSarpras() ||
                      isAdmin() ||
                      isPrincipal()
                    ) &&
                    (request.resource.data.status in ['Dilaporkan', 'Menunggu Persetujuan Kepsek']);

      // Status approval by Kepsek; cost estimation by Sarpras; Reporter can update details if still 'Dilaporkan'
      allow update: if isAuthenticated() &&
                    isValidSarprasTicket(request.resource.data) &&
                    areImmutableFieldsUnchanged(['id', 'ticket_number', 'reported_by_id', 'reported_date']) &&
                    (
                      isPrincipal() ||
                      isSarpras() ||
                      isAdmin() ||
                      (
                        resource.data.reported_by_id == request.auth.uid &&
                        resource.data.status == 'Dilaporkan'
                      )
                    );

      allow delete: if isPrincipal() || isAdmin();
    }

    // ===============================================================
    // 19. PIKET SCHEDULES COLLECTION
    // ===============================================================
    match /piket_schedules/{scheduleId} {
      allow read: if isAuthenticated();

      allow create: if (isAdmin() || isPrincipal()) &&
                    isValidPiketSchedule(request.resource.data);

      allow update: if (isAdmin() || isPrincipal()) &&
                    isValidPiketSchedule(request.resource.data) &&
                    areImmutableFieldsUnchanged(['id']);

      allow delete: if isAdmin();
    }

    // ===============================================================
    // 20. PIKET CHECKLISTS COLLECTION
    // ===============================================================
    match /piket_checklists/{checklistId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() &&
                    isValidPiketChecklist(request.resource.data) &&
                    (
                      request.resource.data.teacher_id == request.auth.uid ||
                      isPiketLapangan() ||
                      isAdmin() ||
                      isPrincipal()
                    );

      allow update: if isAuthenticated() &&
                    isValidPiketChecklist(request.resource.data) &&
                    areImmutableFieldsUnchanged(['id', 'date']) &&
                    (
                      resource.data.teacher_id == request.auth.uid ||
                      isPiketLapangan() ||
                      isAdmin() ||
                      isPrincipal()
                    );

      allow delete: if isAdmin() || isPrincipal();
    }

    // ===============================================================
    // 21. GUEST BOOK COLLECTION
    // ===============================================================
    match /guest_book/{guestId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() &&
                    isValidGuestBook(request.resource.data) &&
                    (
                      request.resource.data.recorded_by_id == request.auth.uid ||
                      isPiketKantor() ||
                      isAdmin() ||
                      isPrincipal()
                    );

      allow update: if isAuthenticated() &&
                    isValidGuestBook(request.resource.data) &&
                    areImmutableFieldsUnchanged(['id', 'recorded_by_id']) &&
                    (
                      resource.data.recorded_by_id == request.auth.uid ||
                      isPiketKantor() ||
                      isAdmin() ||
                      isPrincipal()
                    );

      allow delete: if isAdmin() || isPrincipal();
    }

    // ===============================================================
    // 22. PRINCIPAL AGENDA COLLECTION
    // ===============================================================
    match /principal_agenda/{agendaId} {
      allow read: if isAuthenticated();

      allow create: if (isPrincipal() || isAdmin()) &&
                    isValidPrincipalAgenda(request.resource.data) &&
                    request.resource.data.id == agendaId;

      allow update: if (isPrincipal() || isAdmin()) &&
                    isValidPrincipalAgenda(request.resource.data) &&
                    areImmutableFieldsUnchanged(['id']);

      allow delete: if isPrincipal() || isAdmin();
    }

  }
}
